{
  "name": "googledrive-vscode-extension",
  "displayName": "Google Drive for VS Code",
  "description": "Mount Google Drive as a native workspace folder in VS Code",
  "version": "0.1.5",
  "publisher": "Tutivog",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tut1vog/googledrive-vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:gdrive"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gdriveContainer",
          "title": "Google Drive",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "gdriveContainer": [
        {
          "id": "gdriveExplorer",
          "name": "Files",
          "icon": "images/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gdriveExplorer",
        "contents": "Sign in to browse your Google Drive files.\n[Sign In](command:gdrive.signIn)",
        "when": "!gdrive.isSignedIn"
      }
    ],
    "commands": [
      {
        "command": "gdrive.signIn",
        "title": "Google Drive: Sign In"
      },
      {
        "command": "gdrive.signOut",
        "title": "Google Drive: Sign Out"
      },
      {
        "command": "gdrive.openDrive",
        "title": "Google Drive: Browse & Open Folder"
      },
      {
        "command": "gdrive.openDriveRoot",
        "title": "Google Drive: Open My Drive (Root)"
      },
      {
        "command": "gdrive.refreshTree",
        "title": "Google Drive: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gdrive.newFile",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "gdrive.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "gdrive.delete",
        "title": "Delete"
      },
      {
        "command": "gdrive.rename",
        "title": "Rename"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gdrive.refreshTree",
          "when": "view == gdriveExplorer",
          "group": "navigation"
        },
        {
          "command": "gdrive.openDrive",
          "when": "view == gdriveExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gdrive.newFile",
          "when": "view == gdriveExplorer && viewItem == driveFolder",
          "group": "1_new@1"
        },
        {
          "command": "gdrive.newFolder",
          "when": "view == gdriveExplorer && viewItem == driveFolder",
          "group": "1_new@2"
        },
        {
          "command": "gdrive.rename",
          "when": "view == gdriveExplorer && viewItem =~ /driveFile|driveFolder/",
          "group": "7_edit@1"
        },
        {
          "command": "gdrive.delete",
          "when": "view == gdriveExplorer && viewItem =~ /driveFile|driveFolder/",
          "group": "7_edit@2"
        },
        {
          "command": "gdrive.newFile",
          "when": "view == gdriveExplorer && viewItem == driveFolder",
          "group": "inline"
        },
        {
          "command": "gdrive.newFolder",
          "when": "view == gdriveExplorer && viewItem == driveFolder",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "pretest": "tsc -p test/integration/tsconfig.json",
    "test": "node out/test/integration/runTests.js",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "googleapis": "^131.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.23.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
